# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/contact_db

# ── SMTP (Gmail example — use an App Password, not your real password) ────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=xxxx_xxxx_xxxx_xxxx
EMAIL_FROM=you@gmail.com
EMAIL_FROM_NAME=Contact Form Bot

# ── Organisation recipients (comma-separated) ─────────────────────────────────
ORG_RECIPIENTS=["alice@company.com","bob@company.com"]

# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME=Contact Form API
DEBUG=false
